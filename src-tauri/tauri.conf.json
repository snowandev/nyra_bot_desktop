{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nyra Bot",
  "version": "0.9.5",
  "identifier": "com.snowandev.nyrabot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nyra Bot",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/audio/*"]
      },
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' asset: http://asset.localhost",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' asset: http://asset.localhost",
        "worker-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "snowandev",
    "copyright": "Copyright © 2026 snowandev",
    "homepage": "https://github.com/snowandev/nyra_bot_desktop",
    "category": "Productivity",
    "shortDescription": "Chat with AI models on your computer or in the cloud",
    "longDescription": "Nyra Bot is a desktop app for talking with AI models, local or in the cloud. It works with your files and folders, searches the web, transcribes audio and can guide you on your screen.",
    "windows": {
      "nsis": {
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "headerImage": "windows/nsis-header.bmp",
        "languages": ["English", "Spanish"]
      },
      "wix": {
        "bannerPath": "windows/msi-banner.bmp",
        "dialogImagePath": "windows/msi-dialog.bmp"
      }
    },
    "linux": {
      "deb": { "recommends": ["libayatana-appindicator3-1"] },
      "rpm": { "recommends": ["libayatana-appindicator-gtk3"] }
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QzEwNjg0ODA2M0I0M0EKUldRNnRHT0FoQWJCU0dnVnllVzh2eVRRNGl1K2Jqdm9icVlRVG1NTzd4ZHd6MHdmcDhtb2E4d1cK",
      "endpoints": ["https://github.com/snowandev/nyra_bot_desktop/releases/latest/download/latest.json"]
    }
  }
}
